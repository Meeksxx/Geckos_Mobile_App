{
  "expo": {
    "name": "Gecko's at Lake Texoma",
    "slug": "Geckos_Mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "geckosmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/images/logo/Icon-1024.png",
    "splash": {
      "image": "./assets/images/splash1.png",
      "resizeMode": "contain",
      "imageWidth": 620,
      "backgroundColor": "#0B0C0F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zacmeeks.geckos",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Used to upload photos for menu items, categories, specials, and announcements."
      }
    },
    "android": {
      "package": "com.zacmeeks.geckos",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo/Icon-1024.png",
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "./plugins/withPrivacyManifest",
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo/Icon-1024.png",
          "color": "#0B0C0F",
          "sounds": [],
          "iosDisplayInForeground": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash1.png",
          "imageWidth": 620,
          "resizeMode": "contain",
          "backgroundColor": "#0B0C0F"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.zacmeeks.geckos",
          "enableGooglePay": true
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0e588ad7-be33-486f-a079-90c3e44e3f14"
      }
    }
  }
}
