{
  "expo": {
    "name": "Geckos_Mobile",
    "slug": "Geckos_Mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "geckosmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "splash": {
  "image": "./assets/images/splash1.png",
  "resizeMode": "contain",
  "imageWidth": 620,
  "backgroundColor": "#0B0C0F"
},



    "ios": {
      "supportsTablet": true
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static"
    },

    "plugins": [
      "expo-router",
      [
  "expo-splash-screen",
  {
    "image": "./assets/images/splash1.png",
    "imageWidth": 620,
    "resizeMode": "contain",
    "backgroundColor": "#0B0C0F"
  }
]

    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
